---
import { SITE, copy, type Locale } from '../config/site';
const { locale, alternatePaths = {} } = Astro.props as { locale: Locale; alternatePaths?: Partial<Record<Locale, string>> };
const t = copy[locale];
const switchTo = locale === 'fr' ? 'en' : 'fr';
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={`/${locale}/`} aria-label={`${SITE.name} — home`}><span class="brand-mark" aria-hidden="true">HH</span><span class="brand-name"><strong>HICHAM</strong><em>he baz</em></span></a>
    <nav class="desktop-nav" aria-label={locale === 'fr' ? 'Navigation principale' : 'Primary navigation'}>
      <a class="nav-home" href={`/${locale}/`}>● <span>{locale === 'fr' ? 'Accueil' : 'Home'}</span></a><a href={`/${locale}/services/`}>{t.nav.services}</a><a href={`/${locale}/work/`}>{t.nav.work}</a><a href={`/${locale}/insights/`}>{t.nav.insights}</a><a href={`/${locale}/research/`}>{t.nav.research}</a><a href={`/${locale}/about/`}>{t.nav.about}</a><a class="locale" href={alternatePaths[switchTo] ?? `/${switchTo}/`} lang={switchTo}>{switchTo.toUpperCase()}</a><a class="header-cta" href={`/${locale}/contact/`}>{t.cta}</a>
    </nav>
    <details class="mobile-menu"><summary>Menu</summary><nav aria-label={locale === 'fr' ? 'Navigation principale' : 'Primary navigation'}><a href={`/${locale}/`}>{locale === 'fr' ? 'Accueil' : 'Home'}</a><a href={`/${locale}/services/`}>{t.nav.services}</a><a href={`/${locale}/work/`}>{t.nav.work}</a><a href={`/${locale}/insights/`}>{t.nav.insights}</a><a href={`/${locale}/research/`}>{t.nav.research}</a><a href={`/${locale}/about/`}>{t.nav.about}</a><a href={alternatePaths[switchTo] ?? `/${switchTo}/`} lang={switchTo}>{switchTo.toUpperCase()}</a><a class="button" href={`/${locale}/contact/`}>{t.cta}</a></nav></details>
  </div>
</header>
<style>
.site-header{position:sticky;top:0;z-index:10;border-bottom:1px solid var(--line);background:color-mix(in srgb,var(--paper) 92%,transparent);backdrop-filter:blur(12px)}.header-inner{display:flex;min-height:4.6rem;align-items:center;justify-content:space-between;gap:1.5rem}.brand{display:flex;align-items:center;gap:.65rem;text-decoration:none}.brand-mark{display:grid;width:2.15rem;height:2.15rem;place-items:center;border:1.5px solid var(--ink);border-radius:50%;background:var(--accent-pink);box-shadow:var(--shadow-sticker);color:#fff;font-family:var(--font-tech);font-size:.62rem;font-weight:700;letter-spacing:.04em}.brand-name{display:flex;align-items:baseline;gap:.3rem;font-family:var(--font-tech);font-size:.78rem;letter-spacing:.08em;line-height:1}.brand-name em{color:var(--accent-coral);font-family:var(--font-hand);font-size:1.35rem;letter-spacing:0;font-style:normal;text-transform:lowercase}.desktop-nav{display:flex;align-items:center;gap:.25rem;font-family:var(--font-tech);font-size:.7rem;font-weight:600;letter-spacing:.06em;text-transform:uppercase}.desktop-nav a{padding:.5rem .65rem;border-radius:999px;text-decoration:none}.desktop-nav a:hover{background:var(--paper-deep);color:var(--ink)}.desktop-nav .nav-home{border:1.5px solid var(--ink);background:var(--accent-yellow);box-shadow:1.5px 2px 0 var(--ink);color:var(--ink)}.locale{color:var(--muted)}.header-cta{border:1.5px solid var(--ink);background:var(--white);box-shadow:1.5px 2px 0 var(--ink);color:var(--ink)}.mobile-menu{display:none;position:relative}.mobile-menu summary{min-height:44px;padding:.65rem 0;cursor:pointer;font-family:var(--font-tech);font-size:.75rem;font-weight:700;list-style:none;text-transform:uppercase}.mobile-menu summary::-webkit-details-marker{display:none}.mobile-menu summary::after{margin-left:.4rem;content:'+'}.mobile-menu[open] summary::after{content:'−'}.mobile-menu nav{position:absolute;right:0;display:grid;width:min(18rem,calc(100vw - 2.5rem));gap:.3rem;padding:1rem;border:1px solid var(--line);background:var(--white);box-shadow:var(--shadow-paper)}.mobile-menu nav a{min-height:44px;padding:.55rem;text-decoration:none}@media(max-width:980px){.desktop-nav{display:none}.mobile-menu{display:block}}
</style>
