---
import BaseLayout from '../components/BaseLayout.astro';
import { SITE, copy, type Locale } from '../config/site';
import { formatDate } from '../lib/content';
import { topicSlug } from '../lib/topics';
const { entry,locale,section,alternatePaths={},Content,collection }=Astro.props as any;
const t=copy[locale as Locale]; const path=`/${locale}/${section}/${entry.data.slug}/`; const isService=collection==='services';
const jsonLd=isService?{'@context':'https://schema.org','@type':'Service',name:entry.data.title,serviceType:entry.data.title,description:entry.data.description,url:new URL(path,SITE.url).toString(),provider:{'@type':'Person',name:SITE.owner.name,url:new URL(`/${locale}/about/`,SITE.url).toString()},areaServed:{'@type':'Country',name:'Morocco'},inLanguage:locale}:{'@context':'https://schema.org','@type':collection==='research'?'Report':'Article',headline:entry.data.title,description:entry.data.description,datePublished:entry.data.publishedAt.toISOString(),dateModified:(entry.data.updatedAt??entry.data.publishedAt).toISOString(),inLanguage:locale,mainEntityOfPage:new URL(path,SITE.url).toString(),author:{'@type':'Person',name:entry.data.author,url:new URL(`/${locale}/about/`,SITE.url).toString()}};
---
<BaseLayout title={`${entry.data.title} | ${SITE.name}`} description={entry.data.description} locale={locale} canonicalPath={path} alternatePaths={alternatePaths} jsonLd={jsonLd}><section class="content-hero"><div class="container content-hero-inner"><p class="eyebrow">{section==='insights'?(locale==='fr'?'Analyse':'Insight'):section==='research'?(locale==='fr'?'Recherche':'Research'):section==='work'?(locale==='fr'?'Étude de cas':'Case study'):(locale==='fr'?'Service':'Service')}</p><h1>{entry.data.title}</h1><p class="lead">{entry.data.description}</p><p class="meta">{entry.data.author} · {formatDate(entry.data.publishedAt,locale)}{entry.data.updatedAt&&` · ${locale==='fr'?'Mis à jour':'Updated'} ${formatDate(entry.data.updatedAt,locale)}`}</p>{collection==='articles'&&<p class="topics">{entry.data.topics.map((topic:string)=><a href={`/${locale}/insights/topic/${topicSlug(topic)}/`}>{topic}</a>)}</p>}</div></section><section class="section content-body"><div class="container prose"><Content/>{entry.data.sources.length>0&&<section aria-labelledby="sources"><h2 id="sources">{t.source}</h2><ul>{entry.data.sources.map((source:{label:string;url:string})=><li><a href={source.url} rel="external noopener">{source.label}</a></li>)}</ul></section>}<aside class="content-cta"><p class="eyebrow">{locale==='fr'?'Prochaine étape':'Next step'}</p><h2>{locale==='fr'?'Parlons de votre visibilité.':'Let’s discuss your visibility.'}</h2><a class="button" href={`/${locale}/contact/`}>{t.cta}<span aria-hidden="true">↗</span></a></aside></div></section></BaseLayout>
<style>.content-hero{padding:6.5rem 0 4.5rem;background:radial-gradient(circle at 75% 15%,rgba(247,214,208,.8),transparent 24rem),var(--linen)}.content-hero-inner{max-width:900px}.content-hero h1{max-width:880px;margin:.6rem 0 1.2rem;font-size:clamp(2.55rem,5.6vw,5rem);letter-spacing:-.065em;line-height:1}.lead{max-width:730px;margin:0;color:var(--muted);font-size:1.2rem}.content-hero .meta{margin-top:1.4rem}.topics{display:flex;flex-wrap:wrap;gap:.5rem}.topics a{padding:.28rem .7rem;border:1px solid var(--line);border-radius:999px;background:rgba(255,255,255,.5);font-size:.78rem;text-decoration:none}.content-body{padding-top:4.5rem}.content-cta{margin-top:4rem;padding:2rem;border-radius:1.5rem;background:var(--night);color:#fff}.content-cta h2{max-width:420px;margin:.5rem 0 1.2rem;font-size:1.8rem;letter-spacing:-.045em;line-height:1.1}.content-cta .eyebrow{color:#c4c0ff}@media(max-width:760px){.content-hero{padding:4.5rem 0 3.2rem}.content-body{padding-top:3rem}}</style>
