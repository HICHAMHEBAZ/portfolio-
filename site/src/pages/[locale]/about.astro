---
import BaseLayout from '../../components/BaseLayout.astro'; import { SITE,type Locale } from '../../config/site';
export function getStaticPaths(){return SITE.locale.supported.map((locale)=>({params:{locale}}));} const locale=Astro.params.locale as Locale; const isFr=locale==='fr';
const jsonLd={'@context':'https://schema.org','@type':'ProfilePage',mainEntity:{'@type':'Person',name:SITE.owner.name,jobTitle:SITE.owner.role,description:SITE.owner.description,url:new URL(`/${locale}/about/`,SITE.url).toString()}};
---
<BaseLayout title={`${isFr?'À propos':'About'} | ${SITE.name}`} description={SITE.owner.description} locale={locale} canonicalPath={`/${locale}/about/`} alternatePaths={{fr:'/fr/about/',en:'/en/about/'}} jsonLd={jsonLd}><section class="section"><div class="container prose"><p class="eyebrow">{isFr?'À propos':'About'}</p><h1>{isFr?'Une pratique fondée sur des preuves, pas sur des raccourcis.':'A practice built on evidence, not shortcuts.'}</h1><p>{SITE.owner.description}</p><h2>{isFr?'À personnaliser avant le lancement':'Complete before launch'}</h2><p>{isFr?'Ajoutez votre nom, photo, expérience, preuves, liens professionnels et coordonnées réelles dans la configuration centrale du site.':'Add your real name, photo, experience, proof, professional links, and contact details in the site’s central configuration.'}</p></div></section></BaseLayout>
