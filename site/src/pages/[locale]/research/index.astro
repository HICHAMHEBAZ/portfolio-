---
import BaseLayout from '../../../components/BaseLayout.astro'; import ArticleCard from '../../../components/ArticleCard.astro'; import { SITE,type Locale } from '../../../config/site'; import { localizedEntries } from '../../../lib/content';
export function getStaticPaths(){return SITE.locale.supported.map((locale)=>({params:{locale}}));} const locale=Astro.params.locale as Locale; const entries=await localizedEntries('research',locale);
---
<BaseLayout title={`${locale==='fr'?'Recherche':'Research'} | ${SITE.name}`} description={locale==='fr'?'Études et observations reproductibles sur la visibilité de recherche au Maroc.':'Reproducible studies and observations on search visibility in Morocco.'} locale={locale} canonicalPath={`/${locale}/research/`} alternatePaths={{fr:'/fr/research/',en:'/en/research/'}}><section class="section"><div class="container"><p class="eyebrow">{locale==='fr'?'Recherche':'Research'}</p><h1>{locale==='fr'?'Des hypothèses testées, pas des promesses.':'Tested hypotheses, not promises.'}</h1><div class="grid grid--3">{entries.map((entry)=><ArticleCard entry={entry} collection="research" locale={locale}/>)}</div></div></section></BaseLayout>
