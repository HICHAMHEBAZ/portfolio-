---
import { SITE, type Locale } from '../../config/site';
import { localizedEntries } from '../../lib/content';
import '../../styles/global.css';

export function getStaticPaths() {
  return SITE.locale.supported.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const isFrench = locale === 'fr';
const services = (await localizedEntries('services', locale)).slice(0, 4);
const caseStudies = (await localizedEntries('caseStudies', locale)).slice(0, 3);
const insights = (await localizedEntries('articles', locale)).slice(0, 3);
const title = isFrench ? 'Hicham Hebaz — stratégie marketing et idées qui restent' : 'Hicham Hebaz — strategic marketing and ideas that last';
const description = isFrench
  ? 'Hicham Hebaz explore la stratégie marketing, les comportements et les détails culturels qui donnent aux marques une raison d’être remarquées.'
  : 'Hicham Hebaz explores marketing strategy, human behaviour, and the cultural details that give brands a reason to be remembered.';
const alternatePaths = { fr: '/fr/', en: '/en/' } as const;
const labels = isFrench
  ? { home: 'Accueil', about: 'À propos', thinking: 'Réflexions choisies', services: 'Services', manifestoNav: 'Manifeste', contact: 'Contact', myName: "je m'appelle", availability: 'Ouvert aux projets de stratégie marketing', talk: 'Parlons travail', noBuzzwords: 'sans jargon corporate, promis.', story: 'l’histoire jusqu’ici ↓', whatsUp: "quoi de neuf", aboutLead: 'Je suis étudiant en marketing digital et management, avec une curiosité un peu trop persistante pour ce qui attire l’attention, crée la confiance et reste en mémoire.', fieldNote: 'Les détails culturels sont rarement des détails.', spendTime: 'les sujets auxquels je pense souvent :', selected: 'réflexions choisies', selectedTitle: 'Études, notes et angles de recherche', selectedIntro: 'Des pistes de réflexion en cours — avec leurs hypothèses, leurs limites et ce qui reste à vérifier.', practical: 'le concret ↓', serviceTitle: 'Ce que je peux aider à construire ou affiner', manifestoLabel: '// MANIFESTE PERSONNEL', manifestoQuote: 'Le bon marketing ne court pas seulement après l’attention. Il donne aux gens une vraie raison de s’intéresser.', contactNote: 'toujours ici ?', contactTitle: 'Faisons quelque chose qui mérite d’être remarqué.', contactBody: 'Une question stratégique, une idée à clarifier ou un projet à mettre sur les rails ? Écrivez-moi et commençons par le contexte.', email: 'Écrire un email', linkedin: 'Voir LinkedIn', available: 'Disponible pour de nouveaux projets', based: 'Casablanca / Rabat' }
  : { home: 'Home', about: 'About', thinking: 'Selected thinking', services: 'Services', manifestoNav: 'Manifesto', contact: 'Contact', myName: 'my name is', availability: 'Open to marketing strategy and projects', talk: "Let's talk work", noBuzzwords: 'no corporate buzzwords, promised.', story: 'the story so far ↓', whatsUp: "what's up", aboutLead: 'I am a digital marketing and management student with a persistent curiosity for what earns attention, builds trust, and stays in people’s minds.', fieldNote: 'Cultural details are rarely just details.', spendTime: 'things I spend time thinking about:', selected: 'selected thinking', selectedTitle: 'Studies, notes, and working angles', selectedIntro: 'Ideas in progress — with their hypotheses, limits, and the parts that still need testing.', practical: 'the practical stuff ↓', serviceTitle: 'What I can help you build or refine', manifestoLabel: '// PERSONAL MANIFESTO', manifestoQuote: 'Good marketing does not only chase attention. It gives people a genuine reason to care.', contactNote: 'still here?', contactTitle: "Let's make something worth paying attention to.", contactBody: 'A strategic question, an idea to sharpen, or a project to get moving? Send a note and let’s start with the context.', email: 'Send an email', linkedin: 'View LinkedIn', available: 'Available for new projects', based: 'Casablanca / Rabat' };
const focusAreas = isFrench ? ['Stratégie marketing', 'Récit de marque', 'Psychologie des publics', 'Positionnement', 'Recherche culturelle', 'Architecture de contenu'] : ['Marketing strategy', 'Brand storytelling', 'Audience psychology', 'Positioning', 'Cultural research', 'Content architecture'];
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'Hicham Hebaz', url: SITE.url },
  { '@context': 'https://schema.org', '@type': 'Person', name: 'Hicham Hebaz', jobTitle: isFrench ? 'Stratège marketing' : 'Marketing strategist', url: new URL(`/${locale}/about/`, SITE.url).toString() },
];
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content={description} /><meta name="robots" content="index,follow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" /><link href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;700&family=Inter:wght@400;500;600;700;800;900&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet" />
    <link rel="canonical" href={new URL(`/${locale}/`, SITE.url).toString()} />
    {Object.entries(alternatePaths).map(([alternateLocale, path]) => <link rel="alternate" hreflang={alternateLocale} href={new URL(path, SITE.url).toString()} />)}
    <link rel="alternate" hreflang="x-default" href={new URL('/fr/', SITE.url).toString()} /><meta property="og:type" content="website" /><meta property="og:site_name" content={SITE.name} /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={new URL(`/${locale}/`, SITE.url).toString()} /><meta name="twitter:card" content="summary_large_image" /><title>{title}</title>
    {jsonLd.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
  </head>
  <body class="notebook-body">
    <a class="skip-link" href="#main-content">{isFrench ? 'Aller au contenu' : 'Skip to content'}</a>
    <main id="main-content" class="notebook-sheet">
      <header class="notebook-header">
        <a class="notebook-brand" href={`/${locale}/`} aria-label="Hicham Hebaz — home"><span class="brand-initials" aria-hidden="true">HH</span><span>HICHAM <em>hebaz</em></span></a>
        <nav class="notebook-nav" aria-label={isFrench ? 'Navigation principale' : 'Main navigation'}><a class="nav-active" href="#hero">{labels.home}</a><a href="#about">{labels.about}</a><a href="#case-studies">{labels.thinking}</a><a href="#services">{labels.services}</a><a href="#manifesto">{labels.manifestoNav}</a></nav>
        <div class="header-actions"><a class="social-link" href={alternatePaths[locale === 'fr' ? 'en' : 'fr']} lang={locale === 'fr' ? 'en' : 'fr'}>{locale === 'fr' ? 'EN' : 'FR'}</a><a class="header-contact" href="#contact">{labels.contact} <span aria-hidden="true">↗</span></a></div>
      </header>

      <section id="hero" class="hero-notebook" aria-labelledby="hero-title">
        <p class="hand-label">{labels.myName}</p>
        <div class="name-lockup"><span class="sticker sticker-mint sticker-top-left">MADE THINGS</span><span class="sticker sticker-yellow sticker-top-right">SWEAT THE DETAILS</span><div class="name-box"><h1 id="hero-title">HICHAM</h1><span class="name-rule"></span><strong>HEBAZ</strong></div><span class="sticker sticker-yellow sticker-bottom-left">MARKETING STRATEGIST</span><span class="sticker sticker-mint sticker-bottom-right">MOROCCO</span></div>
        <p class="availability"><span class="status-dot" aria-hidden="true"></span>{labels.availability}</p>
        <div class="hero-statement"><span class="doodle doodle-left" aria-hidden="true">↗</span><h2>{isFrench ? 'Je transforme les idées, les insights et la culture en marketing que les gens retiennent.' : 'I turn ideas, insights, and culture into marketing people actually remember.'}</h2><span class="doodle doodle-right" aria-hidden="true">✳</span></div>
        <a class="tactile-button" href="#contact"><span aria-hidden="true">■</span>{labels.talk}</a><p class="hand-caption">{labels.noBuzzwords}</p><div class="story-divider"><span>{labels.story}</span></div>
      </section>

      <section id="about" class="notebook-section about-section" aria-labelledby="about-title">
        <div class="section-title-center"><p class="hand-label">{isFrench ? 'à propos de moi !' : 'about me!'}</p><h2 id="about-title" class="label-title">{labels.whatsUp}</h2></div>
        <div class="scrapbook-grid"><figure class="polaroid polaroid-light"><div class="tape tape-blue" aria-hidden="true"></div><div class="portrait-placeholder"><span>HH</span><small>marketing<br />&amp; management</small></div><figcaption class="hand-caption">{isFrench ? 'Hicham dans sa zone' : 'Hicham in his zone'}</figcaption></figure><div class="about-note"><span class="note-mark" aria-hidden="true">✳</span><p>{labels.aboutLead}</p><div class="note-meta"><span>Student &amp; independent strategist</span><span>Casablanca / Rabat, MA</span></div></div><aside class="polaroid polaroid-dark"><div class="tape tape-yellow" aria-hidden="true"></div><p class="mono-label">FIELD NOTES</p><p class="field-quote">“{labels.fieldNote}”</p><div class="note-meta"><span>CASABLANCA</span><span>2026</span></div><p class="hand-caption">strategy + curiosity</p></aside></div>
        <div class="focus-areas"><p class="hand-caption">{labels.spendTime}</p><div class="sticker-list">{focusAreas.map((area, index) => <span class={`focus-sticker focus-${index + 1}`}>{area}</span>)}</div></div>
      </section>

      <section id="case-studies" class="notebook-section thinking-section" aria-labelledby="thinking-title"><div class="section-heading-line"><div><p class="mono-label accent-coral">• {labels.selected}</p><h2 id="thinking-title">{labels.selectedTitle}</h2></div><p class="hand-caption">{labels.selectedIntro}</p></div><div class="folder-stack">
        {caseStudies.map((entry, index) => <article class={`folder folder-${index + 1}`}><div class="folder-tab">★ {isFrench ? `DOSSIER 0${index + 1}` : `STUDY 0${index + 1}`} <span>/</span> {entry.data.clientType}</div><div class="folder-content"><div><p class="mono-label">{entry.data.timeframe}</p><h3>{entry.data.title}</h3><p>{entry.data.description}</p><a class="folder-link" href={`/${locale}/work/${entry.data.slug}/`}>{isFrench ? 'Lire l’étude' : 'Read the case study'} <span aria-hidden="true">↗</span></a></div><div class="folder-aside"><span class="mono-label">{isFrench ? 'CE QUI EST MESURÉ' : 'WHAT IS MEASURED'}</span><strong>{entry.data.outcome}</strong><small>{entry.data.clientType}</small></div></div></article>)}
        {caseStudies.length === 0 && insights.map((entry, index) => <article class={`folder folder-${index + 1}`}><div class="folder-tab">★ {isFrench ? `NOTE 0${index + 1}` : `NOTE 0${index + 1}`} <span>/</span> {entry.data.topics[0]}</div><div class="folder-content"><div><p class="mono-label">{entry.data.publishedAt.toLocaleDateString(locale === 'fr' ? 'fr-MA' : 'en-GB', { month: 'long', year: 'numeric' })}</p><h3>{entry.data.title}</h3><p>{entry.data.excerpt}</p><a class="folder-link" href={`/${locale}/insights/${entry.data.slug}/`}>{isFrench ? 'Lire la note' : 'Read the note'} <span aria-hidden="true">↗</span></a></div><div class="folder-aside"><span class="mono-label">ANGLE</span><strong>{entry.data.topics[0]}</strong><small>{isFrench ? 'Note de recherche' : 'Research note'}</small></div></div></article>)}
      </div></section>

      <section id="services" class="notebook-section services-section" aria-labelledby="services-title"><p class="hand-label accent-coral">{labels.practical}</p><h2 id="services-title">{labels.serviceTitle}</h2><div class="service-grid">{services.map((service, index) => <article class="service-note"><span class={`service-number service-color-${index + 1}`}>0{index + 1}</span><h3>{service.data.title}</h3><p>{service.data.description}</p><a href={`/${locale}/services/${service.data.slug}/`}>{isFrench ? 'Voir le service' : 'Explore the service'} <span aria-hidden="true">↗</span></a></article>)}</div></section>
      <section id="manifesto" class="manifesto-section" aria-labelledby="manifesto-title"><div class="manifesto-card"><p class="mono-label">{labels.manifestoLabel}</p><h2 id="manifesto-title">“{labels.manifestoQuote}”</h2><p class="hand-caption">{isFrench ? 'note de carnet #14' : 'notebook entry #14'}</p></div></section>
      <section id="contact" class="contact-section" aria-labelledby="contact-title"><div class="contact-board"><p class="hand-label accent-coral">{labels.contactNote}</p><h2 id="contact-title">{labels.contactTitle}</h2><p>{labels.contactBody}</p><div class="contact-actions"><a class="contact-primary" href={SITE.email ? `mailto:${SITE.email}` : `/${locale}/contact/`}>{labels.email} <span aria-hidden="true">↗</span></a>{SITE.social.linkedin && <a class="contact-secondary" href={SITE.social.linkedin} rel="noreferrer">{labels.linkedin} <span aria-hidden="true">↗</span></a>}</div><div class="contact-meta"><span>{labels.based}</span><span><i aria-hidden="true"></i>{labels.available}</span></div></div></section>
      <footer class="notebook-footer"><strong>HICHAM HEBAZ</strong><span>{isFrench ? 'stratégie × curiosité × détails qui comptent' : 'strategy × curiosity × details that matter'}</span><a href="#hero">{isFrench ? 'retour en haut ↑' : 'back to top ↑'}</a></footer>
    </main>
  </body>
</html>

<style>
  :global(body){font-family:Inter,ui-sans-serif,system-ui,sans-serif}.notebook-body{--paper:#f8f7f0;--line:#d8d3c5;--ink:#171615;--coral:#ff5e4d;--pink:#f75c7e;--yellow:#f7c631;--mint:#5bcfa5;--blue:#2b59ff;background-color:#e8e7e0;background-image:linear-gradient(to right,rgba(160,156,144,.2) 1px,transparent 1px),linear-gradient(to bottom,rgba(160,156,144,.2) 1px,transparent 1px);background-size:32px 32px;color:var(--ink)}.notebook-sheet{position:relative;width:min(1320px,calc(100% - 2rem));margin:2rem auto 0;overflow:hidden;border:1px solid #dcd6c5;border-radius:1rem;background-color:var(--paper);background-image:repeating-linear-gradient(transparent,transparent 31px,#e6e2d4 31px,#e6e2d4 32px);background-position:0 8px;box-shadow:0 25px 65px -15px rgba(26,24,20,.18)}.notebook-sheet:before{position:absolute;top:0;bottom:0;left:2.25rem;width:1.5px;background:rgba(242,139,130,.4);content:'';pointer-events:none}.notebook-header{position:sticky;top:0;z-index:10;display:flex;align-items:center;justify-content:space-between;gap:1.2rem;padding:.8rem clamp(1rem,4vw,3rem);border-bottom:1px solid #e4dfce;background:rgba(248,247,240,.92);backdrop-filter:blur(12px)}.notebook-brand{display:flex;align-items:center;gap:.6rem;font-family:'Space Grotesk',sans-serif;font-size:.8rem;font-weight:700;letter-spacing:-.03em;line-height:1;text-decoration:none}.notebook-brand em{color:var(--coral);font-family:Caveat,cursive;font-size:1.4rem;font-style:normal}.brand-initials{display:grid;width:2rem;height:2rem;place-items:center;border-radius:50%;background:var(--pink);color:#fff;font-size:.65rem}.notebook-nav{display:flex;align-items:center;gap:.2rem;font-family:'Space Grotesk',sans-serif;font-size:.63rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase}.notebook-nav a,.social-link,.header-contact{padding:.45rem .6rem;border-radius:999px;text-decoration:none}.notebook-nav a:hover,.notebook-nav .nav-active{background:var(--yellow);color:var(--ink)}.header-actions{display:flex;align-items:center;gap:.35rem;font-family:'Space Grotesk',sans-serif;font-size:.66rem;font-weight:700}.social-link{border:1px solid var(--ink)}.header-contact{border:1px solid var(--ink);background:#fff;box-shadow:2px 2px 0 var(--ink)}.hero-notebook{max-width:960px;margin:0 auto;padding:4.6rem 2rem 3.4rem;text-align:center}.hand-label,.hand-caption{font-family:Caveat,cursive;font-size:1.45rem;font-weight:500;line-height:1.1}.hand-label{margin:0;color:#585650}.name-lockup{position:relative;display:inline-block;margin:1rem 0 1.5rem}.name-box{position:relative;padding:1rem clamp(1.7rem,6vw,4rem);border:2.5px solid var(--coral);border-radius:.55rem;background:#faf9f4;box-shadow:3px 4px 0 rgba(255,94,77,.25)}.name-box h1{margin:0;font-family:'Space Grotesk',sans-serif;font-size:clamp(3rem,10vw,6.1rem);font-weight:700;letter-spacing:-.1em;line-height:.86}.name-box strong{font-family:'Space Grotesk',sans-serif;font-size:clamp(1.1rem,3vw,2rem);letter-spacing:.24em}.name-rule{display:block;height:4px;margin:.35rem 0;background:linear-gradient(90deg,var(--coral),var(--yellow),var(--mint));border-radius:999px;opacity:.65}.sticker{position:absolute;padding:.35rem .7rem;border:1px solid var(--ink);border-radius:.15rem;box-shadow:2px 3px 0 rgba(0,0,0,.12);font-family:'Space Grotesk',sans-serif;font-size:.55rem;font-weight:700;letter-spacing:.04em;white-space:nowrap}.sticker-mint{background:rgba(91,207,165,.8)}.sticker-yellow{background:rgba(247,198,49,.82)}.sticker-top-left{top:-1rem;left:-2rem;transform:rotate(-6deg)}.sticker-top-right{top:-1rem;right:-2.2rem;transform:rotate(3deg)}.sticker-bottom-left{bottom:-1rem;left:-1.6rem;transform:rotate(3deg)}.sticker-bottom-right{right:-1.5rem;bottom:-1rem;transform:rotate(-2deg)}.availability{display:inline-flex;align-items:center;gap:.5rem;margin:1.5rem 0 1.2rem;padding:.45rem .85rem;border:1px solid #b8b4aa;border-radius:999px;color:#4f4c46;font-family:'Space Grotesk',sans-serif;font-size:.62rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase}.status-dot{width:.48rem;height:.48rem;border-radius:50%;background:var(--blue);box-shadow:0 0 0 4px rgba(43,89,255,.12);animation:pulse 2.2s ease-in-out infinite}.hero-statement{position:relative;max-width:800px;margin:0 auto}.hero-statement h2{margin:.5rem 0 1.7rem;font-size:clamp(2rem,5vw,4rem);font-weight:800;letter-spacing:-.065em;line-height:1.08}.doodle{position:absolute;font-family:Caveat,cursive;font-size:2rem}.doodle-left{top:0;left:-1rem;color:var(--coral);transform:rotate(-15deg)}.doodle-right{right:-1rem;bottom:.2rem;color:var(--yellow);transform:rotate(12deg)}.tactile-button,.contact-primary{display:inline-flex;align-items:center;gap:.6rem;padding:.85rem 1.5rem;border:2px solid var(--ink);border-radius:.35rem;background:var(--ink);box-shadow:4px 5px 0 var(--ink);color:#fff;font-family:'Space Grotesk',sans-serif;font-size:.72rem;font-weight:700;letter-spacing:.08em;text-decoration:none;transition:transform .2s ease,box-shadow .2s ease}.tactile-button:hover,.contact-primary:hover{color:#fff;transform:translate(2px,2px);box-shadow:2px 3px 0 var(--ink)}.tactile-button span{color:#7fb2ff}.hero-notebook>.hand-caption{margin:.7rem 0 0;color:#6f6b63}.story-divider{position:relative;max-width:620px;margin:3.2rem auto 0;border-top:1px dashed #a7a399}.story-divider span{position:relative;top:-.85rem;padding:0 1rem;background:var(--paper);color:#6f6b63;font-family:Caveat,cursive;font-size:1.3rem}.notebook-section{padding:3.4rem clamp(1.2rem,5vw,4rem)}.section-title-center{text-align:center}.section-title-center .hand-label{margin-bottom:.1rem}.label-title{display:inline-block;margin:0;padding:.4rem .8rem;border:2px solid var(--ink);border-radius:.2rem;background:#fff;box-shadow:3px 4px 0 var(--ink);font-family:'Space Grotesk',sans-serif;font-size:.8rem;letter-spacing:.12em;text-transform:uppercase}.scrapbook-grid{display:grid;grid-template-columns:1fr 2fr 1fr;align-items:start;gap:2.2rem;max-width:1080px;margin:2.5rem auto 0}.polaroid{position:relative;padding:1rem 1rem 1.2rem;background:#fff;box-shadow:0 10px 18px rgba(26,24,20,.12)}.polaroid-light{transform:rotate(-3deg)}.polaroid-dark{padding:1.2rem;background:#181816;color:#fff;transform:rotate(3deg);box-shadow:4px 5px 0 var(--ink)}.tape{position:absolute;top:-.7rem;left:50%;width:5rem;height:1.35rem;transform:translateX(-50%) rotate(2deg);opacity:.78}.tape-blue{background:rgba(147,197,253,.75)}.tape-yellow{background:rgba(247,198,49,.76);transform:translateX(-50%) rotate(-1deg)}.portrait-placeholder{display:grid;aspect-ratio:1;place-items:center;align-content:center;gap:.35rem;border:1px solid #d6d1c5;background:#f3f0e6;text-align:center}.portrait-placeholder span{font-family:'Space Grotesk',sans-serif;font-size:2rem;font-weight:800}.portrait-placeholder small{font-family:'Space Grotesk',sans-serif;font-size:.58rem;text-transform:uppercase}.polaroid .hand-caption{margin:.6rem 0 0;text-align:center}.about-note{position:relative;padding:2rem;background:rgba(255,255,255,.82);border:1px solid #d0cbbf;border-radius:.75rem}.about-note>p{margin:0;font-family:Caveat,cursive;font-size:clamp(1.7rem,3vw,2.35rem);line-height:1.25}.note-mark{position:absolute;top:1rem;right:1.2rem;color:var(--yellow);font-size:1.5rem}.note-meta{display:flex;justify-content:space-between;gap:1rem;margin-top:1.5rem;padding-top:.75rem;border-top:1px solid rgba(0,0,0,.12);font-family:'Space Grotesk',sans-serif;font-size:.56rem;letter-spacing:.07em;text-transform:uppercase}.mono-label{margin:0;font-family:'Space Grotesk',sans-serif;font-size:.58rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase}.polaroid-dark .mono-label{color:var(--yellow)}.field-quote{margin:2rem 0 1.4rem;color:#d4d1c7;font-size:.9rem;font-style:italic;line-height:1.5}.polaroid-dark .note-meta{border-color:#3a3935;color:#96938b}.polaroid-dark .hand-caption{color:#cbc8be}.focus-areas{max-width:850px;margin:2.8rem auto 0;text-align:center}.focus-areas .hand-caption{margin:.5rem 0 .8rem;color:#6f6b63}.