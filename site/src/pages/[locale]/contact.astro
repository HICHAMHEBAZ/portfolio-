---
import BaseLayout from '../../components/BaseLayout.astro'; import { SITE,type Locale } from '../../config/site';
export function getStaticPaths(){return SITE.locale.supported.map((locale)=>({params:{locale}}));} const locale=Astro.params.locale as Locale; const isFr=locale==='fr';
---
<BaseLayout title={`${isFr?'Contact':'Contact'} | ${SITE.name}`} description={isFr?'Demandez un audit de visibilité pour votre activité au Maroc.':'Request a visibility audit for your Moroccan business.'} locale={locale} canonicalPath={`/${locale}/contact/`} alternatePaths={{fr:'/fr/contact/',en:'/en/contact/'}}><section class="section"><div class="container prose"><p class="eyebrow">Contact</p><h1>{isFr?'Commençons par votre point de départ.':'Start with your current position.'}</h1><p>{isFr?'Décrivez votre activité, ville, marchés visés et principale source actuelle de demandes.':'Tell me about your business, city, target markets, and current primary source of inquiries.'}</p>{SITE.email||SITE.whatsappUrl?<p>{SITE.email&&<a class="button" href={`mailto:${SITE.email}?subject=${encodeURIComponent(isFr?'Demande d’audit de visibilité':'Visibility audit request')}`}>{isFr?'Écrire un email':'Send an email'}</a>} {SITE.whatsappUrl&&<a class="button button--quiet" href={SITE.whatsappUrl}>{isFr?'Écrire sur WhatsApp':'Message on WhatsApp'}</a>}</p>:<p class="contact-note">{isFr?'Les coordonnées directes seront ajoutées très prochainement.':'Direct contact details will be added shortly.'}</p>}<p class="meta">{isFr?'Un formulaire sécurisé pourra être ajouté lorsque votre fournisseur de messagerie et Turnstile seront configurés.':'A secure form can be added once your mail provider and Turnstile are configured.'}</p></div></section></BaseLayout>
<style>.contact-note{padding:1rem 1.15rem;border:1px solid var(--line);border-radius:1rem;background:var(--linen);color:var(--muted)}</style>
