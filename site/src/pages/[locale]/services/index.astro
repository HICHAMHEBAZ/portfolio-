---
import BaseLayout from '../../../components/BaseLayout.astro'; import { SITE,type Locale } from '../../../config/site'; import { localizedEntries } from '../../../lib/content';
export function getStaticPaths(){return SITE.locale.supported.map((locale)=>({params:{locale}}));} const locale=Astro.params.locale as Locale; const services=await localizedEntries('services',locale);
---
<BaseLayout title={`${locale==='fr'?'Services':'Services'} | ${SITE.name}`} description={locale==='fr'?'Des interventions SEO, Maps et recherche IA reliées aux demandes directes.':'SEO, Maps and AI-search work connected to direct demand.'} locale={locale} canonicalPath={`/${locale}/services/`} alternatePaths={{fr:'/fr/services/',en:'/en/services/'}}><section class="section"><div class="container"><p class="eyebrow">Services</p><h1>{locale==='fr'?'Faire de la visibilité un canal de demande directe.':'Turn visibility into a direct-demand channel.'}</h1><div class="grid grid--3">{services.map((service)=><article class="card"><h2><a href={`/${locale}/services/${service.data.slug}/`}>{service.data.title}</a></h2><p>{service.data.description}</p><p class="meta">{service.data.startingFrom}</p><a href={`/${locale}/services/${service.data.slug}/`}>{locale==='fr'?'Détails du service':'Service details'} →</a></article>)}</div></div></section></BaseLayout>
